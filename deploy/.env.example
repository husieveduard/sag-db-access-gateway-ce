# Console is exposed only on localhost.
# A host-level reverse Nginx terminates HTTPS and proxies to this port.
SAG_CE_HTTP_BIND=127.0.0.1
SAG_CE_HTTP_PORT=18081

# Public HTTPS URL for the web console.
SAG_CE_PUBLIC_URL=https://db-ce.example.local

# DNS name or IP used by DB clients for dynamic gateway ports.
SAG_CE_GATEWAY_PUBLIC_HOST=db-ce.example.local

# Dynamic ports exposed from the worker container.
SAG_CE_DB_GATEWAY_PORT_MIN=16000
SAG_CE_DB_GATEWAY_PORT_MAX=17999

# Dedicated Docker subnet. Used to restrict internal gateway API paths.
SAG_CE_DOCKER_SUBNET=172.31.250.0/24

# Generated automatically by scripts/install.sh.
SAG_CE_APP_KEY=base64:CHANGE_ME
SAG_CE_INTERNAL_TOKEN=CHANGE_ME
SAG_CE_POSTGRES_PASSWORD=CHANGE_ME
SAG_CE_REDIS_PASSWORD=CHANGE_ME

SAG_CE_POSTGRES_DB=sag_db_ce
SAG_CE_POSTGRES_USER=sag_db_ce

# Must stay true for HTTPS reverse-proxy deployment.
SAG_CE_SESSION_SECURE_COOKIE=true

SAG_CE_MAIL_FROM_ADDRESS=no-reply@example.invalid
