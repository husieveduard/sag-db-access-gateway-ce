APP_NAME="SAG DB Access Gateway CE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:18080

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

SAG_EDITION=ce
SAG_INTERNAL_TOKEN=CHANGE_ME

SAG_GATEWAY_CONTROL_PLANE_URL=http://nginx
SAG_DB_GATEWAY_BINARY=/usr/local/bin/sag-db-gateway
SAG_DB_GATEWAY_LOG_DIR=/var/lib/sag/db-gateway/logs
SAG_DB_GATEWAY_LISTEN_HOST=0.0.0.0
SAG_DB_GATEWAY_PUBLIC_HOST=CHANGE_ME
SAG_DB_GATEWAY_PORT_MIN=16000
SAG_DB_GATEWAY_PORT_MAX=17999
SAG_DB_TERMINATION_DRIVER=artisan
SAG_DB_MAINTENANCE_SCHEDULE_ENABLED=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sag_db_access_ce
DB_USERNAME=sag_ce
DB_PASSWORD=CHANGE_ME

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS=sag-db-ce@example.local
MAIL_FROM_NAME="${APP_NAME}"
